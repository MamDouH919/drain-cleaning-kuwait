# ─────────────────────────────────────────────────────────────────────────────
# Headless CMS (read-only public REST API) — powers /articles/hub/*
# Copy this file to `.env.local` for local dev and set real values.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the CMS public API, including the `/api` suffix, NO trailing slash.
#   dev:  http://localhost:3000/api
#   prod: https://cms.example.com/api
CMS_API_BASE_URL="https://amcms-dev.novaslash.com/api"

# The site slug registered in the CMS for THIS website.
# Used as `:siteSlug` in /public/sites/:siteSlug/... requests.
CMS_SITE_SLUG=taslikmajarikuwait